# Copy this file to .env and fill in YOUR values. Never commit .env.
# MySQL:
DB_URL=mysql+pymysql://root:YourPassword@localhost:3306/spend_db
# SQL Server, Windows login:
# DB_URL=mssql+pyodbc://@localhost\SQLEXPRESS/spend_db?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes
# SQL Server, SQL login:
# DB_URL=mssql+pyodbc://sa:YourPassword@localhost/spend_db?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
# Optional Claude key:
# ANTHROPIC_API_KEY=
